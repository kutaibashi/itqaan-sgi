---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Film from '../../components/Film.astro';
import About from '../../components/About.astro';
import Objectives from '../../components/Objectives.astro';
import Path from '../../components/Path.astro';
import Voices from '../../components/Voices.astro';
import Gallery from '../../components/Gallery.astro';
import Areas from '../../components/Areas.astro';
import Contact from '../../components/Contact.astro';
import DonationSection from '../../components/DonationSection.astro';
import Footer from '../../components/Footer.astro';
import DonateModal from '../../components/DonateModal.astro';
---

<Layout
  title="Itqaan Foundation for Education and Development"
  description="Itqaan is an educational foundation dedicated to teaching proper Arabic, Qur'an recitation, memorization, and nurturing values derived from the Qur'an."
  lang="en"
>
  <Header lang="en" />
  <main id="main">
    <Hero lang="en" />
    <Path lang="en" />
    <Areas lang="en" />
    <Voices lang="en" />
    <Gallery lang="en" />
    <Film lang="en" />
    <About lang="en" />
    <Objectives lang="en" />
    <DonationSection lang="en" />
    <Contact lang="en" />
  </main>
  <Footer lang="en" />
  <DonateModal lang="en" />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import VideoSection from '../../components/VideoSection.astro';
import StatsSection from '../../components/StatsSection.astro';
import About from '../../components/About.astro';
import Objectives from '../../components/Objectives.astro';
import Projects from '../../components/Projects.astro';
import ImageSlider from '../../components/ImageSlider.jsx';
import Testimonials from '../../components/Testimonials.jsx';
import Areas from '../../components/Areas.astro';
import Contact from '../../components/Contact.astro';
import DonationSection from '../../components/DonationSection.astro';
import Footer from '../../components/Footer.astro';
import DonateModal from '../../components/DonateModal.astro';
---

<Layout
  title="Itkan Foundation for Education and Development"
  description="Itkan is an educational foundation dedicated to teaching proper Arabic, Qur'an recitation, memorization, and nurturing values derived from the Qur'an."
  lang="en"
>
  <Header lang="en" />
  <main>
    <Hero lang="en" />
    <VideoSection lang="en" />
    <StatsSection lang="en" />
    <About lang="en" />
    <Objectives lang="en" />
    <Projects lang="en" />
    <ImageSlider client:visible lang="en" />
    <Testimonials client:visible lang="en" />
    <DonationSection lang="en" />
    <Areas lang="en" />
    <Contact lang="en" />
  </main>
  <Footer lang="en" />
  <DonateModal lang="en" />
</Layout>

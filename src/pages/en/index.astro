---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ImageSlider from '../../components/ImageSlider.jsx';
---

<Layout
  title="Itkan Academy for Qur'an Memorization"
  description="Itkan is an educational foundation dedicated to teaching proper Arabic, Qur'an recitation, memorization, and nurturing values derived from the Qur'an."
  lang="en"
>
  <Header lang="en" />
  <main>
    <!-- Hero -->
    <section class="relative bg-[#0a3d62] overflow-hidden min-h-[85vh] flex items-center border-b-[8px] border-[#8bc34a]">
      <div class="absolute inset-0">
        <img src="/slider-1.jpg" alt="" class="w-full h-full object-cover opacity-15" fetchpriority="high" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0a3d62]/70 via-[#0a3d62]/85 to-[#0a3d62]/95"></div>
      </div>
      <div class="absolute inset-0 islamic-pattern opacity-30"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 w-full">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.2] mb-8 font-heading drop-shadow-md">
            Itkan <span class="text-[#8bc34a]">Academy</span>
            <span class="block mt-4 text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white/90">for Qur'an Memorization</span>
          </h1>
          <p class="text-lg md:text-xl lg:text-2xl text-white/80 max-w-3xl mx-auto mb-12 leading-relaxed">
            An educational foundation dedicated to teaching proper Arabic, Qur'an recitation and memorization, and nurturing the values and principles of the Qur'an to raise a conscious generation that contributes to the advancement of society.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <button
              id="donation-widget-1778468326670-yz11h-hero-en"
              class="donation-widget donation-widget-button inline-flex items-center justify-center w-full sm:w-auto px-10 py-4 bg-[#8bc34a] text-[#0a3d62] font-black text-lg rounded-md hover:bg-[#7cb342] transition-colors duration-300 shadow-lg cursor-pointer"
              data-template-id="rcm86pmBCrlDhTbuU3tt"
              data-template-name="Itqaan Academy for Qur'an Memorization"
              data-tenant-id="bonyan-ngo"
              data-base-url="https://donate.sgi.ngo/donate-directly/contribution?cause=false&value=rcm86pmBCrlDhTbuU3tt&hideOtherCausesCampaigns=yes&header=no-header"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
              </svg>
              Donate Now
            </button>
            <a href="#programs" class="inline-flex items-center justify-center w-full sm:w-auto px-10 py-4 bg-transparent text-white border-2 border-[#1a9a98] font-bold text-lg rounded-md hover:bg-[#1a9a98] hover:text-white transition-colors duration-300">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3z"/>
              </svg>
              Our Programs
            </a>
            <a href="#contact" class="inline-flex items-center justify-center w-full sm:w-auto px-10 py-4 bg-transparent text-white border-2 border-white/20 font-bold text-lg rounded-md hover:bg-white/10 hover:border-white transition-colors duration-300">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Section -->
    <section class="py-20 md:py-28 bg-gradient-to-b from-white to-[#f8fafb] relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#1a9a98]/20 to-transparent"></div>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#1a9a98]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-5">
            <svg class="w-4 h-4 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
            </svg>
            Learn More
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">
            Discover <span class="gradient-text">Itkan Academy</span>
          </h2>
          <p class="text-xl text-gray-500 leading-relaxed">
            Watch this introductory video to learn about our mission, vision, and what we offer our students.
          </p>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-black border-4 border-white">
          <div class="relative w-full aspect-video">
            <iframe
              src="https://www.youtube.com/embed/9vrkcedB9LM?start=1&rel=0&modestbranding=1"
              title="Itkan Academy for Qur'an Memorization"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full"
            ></iframe>
          </div>
        </div>
        <div class="mt-10 text-center">
          <a href="https://www.youtube.com/@ITKANDERNEGI" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Subscribe to our YouTube channel
          </a>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden border-y border-[#1a9a98]/20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-2">500+</p>
            <p class="text-gray-600 font-medium">Students</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-2">15+</p>
            <p class="text-gray-600 font-medium">Educational Centers</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-2">7</p>
            <p class="text-gray-600 font-medium">Programs</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-2">9+</p>
            <p class="text-gray-600 font-medium">Cities & Regions</p>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="py-20 md:py-28 bg-[#f9fbfb] relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a9a98]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-4">About Us</span>
          <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">Who is <span class="gradient-text">Itkan?</span></h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
          <div class="bg-gradient-to-br from-[#0a3d62] to-[#0d4e7a] rounded-2xl p-8 md:p-10 text-white relative overflow-hidden shadow-xl">
            <div class="relative">
              <h3 class="text-2xl font-bold mb-4 text-[#8bc34a]">Our Vision</h3>
              <p class="text-white/90 leading-relaxed text-lg">To be a pioneering reference foundation that contributes to building a conscious generation and the advancement of society through Qur'anic education.</p>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-8 md:p-10 border border-gray-100 shadow-lg">
            <h3 class="text-2xl font-bold mb-4 text-[#1a9a98]">Our Mission</h3>
            <p class="text-gray-600 leading-relaxed text-lg">Teaching proper Arabic, mastering and memorizing the Holy Qur'an, and nurturing values and principles to graduate a conscious generation that contributes to the advancement of society.</p>
          </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="bg-white rounded-xl p-6 text-center border border-gray-100 shadow-sm hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-[#1a9a98]/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <h4 class="font-bold text-[#0a3d62] mb-2">Mastery</h4>
            <p class="text-gray-500 text-sm">Commitment to excellence in education</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center border border-gray-100 shadow-sm hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-[#1a9a98]/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <h4 class="font-bold text-[#0a3d62] mb-2">Role Model</h4>
            <p class="text-gray-500 text-sm">Leading by example</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center border border-gray-100 shadow-sm hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-[#1a9a98]/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
            </div>
            <h4 class="font-bold text-[#0a3d62] mb-2">Support</h4>
            <p class="text-gray-500 text-sm">Supporting students every step</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center border border-gray-100 shadow-sm hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-[#1a9a98]/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
            </div>
            <h4 class="font-bold text-[#0a3d62] mb-2">Trust</h4>
            <p class="text-gray-500 text-sm">A safe learning environment</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Objectives -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#8bc34a]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-4">Our Goals</span>
            <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-8">What We Strive For</h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#0a3d62] text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">1</div>
                <p class="text-gray-600 text-lg">Spreading Qur'anic knowledge and Islamic sciences</p>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#0a3d62] text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">2</div>
                <p class="text-gray-600 text-lg">Combating illiteracy and teaching proper Arabic</p>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#0a3d62] text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">3</div>
                <p class="text-gray-600 text-lg">Qualifying teachers with modern educational methods</p>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#0a3d62] text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">4</div>
                <p class="text-gray-600 text-lg">Connecting students with authentic Islamic sources</p>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#0a3d62] text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">5</div>
                <p class="text-gray-600 text-lg">Providing a safe and nurturing learning environment</p>
              </div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-[#0a3d62] to-[#0d4e7a] rounded-2xl p-8 md:p-10 text-white relative overflow-hidden shadow-xl">
            <div class="relative">
              <svg class="w-12 h-12 text-[#8bc34a] mb-4 opacity-80" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
              <blockquote class="text-xl md:text-2xl font-bold leading-relaxed mb-6">"Read the Qur'an, for it will come as an intercessor for its companions on the Day of Resurrection."</blockquote>
              <p class="text-white/70">— Muslim</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Programs -->
    <section id="programs" class="py-20 md:py-28 bg-[#f9fbfb] relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a9a98]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-4">Our Programs</span>
          <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">Programs & <span class="gradient-text">Projects</span></h2>
          <p class="text-xl text-gray-500">Comprehensive educational programs serving students of all ages</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          <div class="bg-white rounded-2xl p-8 border border-gray-100 border-t-[#1a9a98] border-t-[4px] shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
            <h3 class="text-xl font-bold text-[#0a3d62] mb-3">Bi-Qira'ah Nahya</h3>
            <p class="text-gray-500 text-sm leading-relaxed">A comprehensive program teaching correct reading and Tajweed for beginners of all ages.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 border-t-[#8bc34a] border-t-[4px] shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
            <h3 class="text-xl font-bold text-[#0a3d62] mb-3">Al-Safra</h3>
            <p class="text-gray-500 text-sm leading-relaxed">A group Qur'an completion project strengthening connection with the Holy Book.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 border-t-[#0a3d62] border-t-[4px] shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
            <h3 class="text-xl font-bold text-[#0a3d62] mb-3">Al-Mahir bil-Qur'an</h3>
            <p class="text-gray-500 text-sm leading-relaxed">An advanced program for mastering the ten Qira'at and becoming a Qur'an expert.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 border-t-[#1a9a98] border-t-[4px] shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
            <h3 class="text-xl font-bold text-[#0a3d62] mb-3">Zad Al-Mu'min</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Islamic sciences and faith enrichment program for comprehensive religious education.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 border-t-[#8bc34a] border-t-[4px] shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
            <h3 class="text-xl font-bold text-[#0a3d62] mb-3">Al-Maqari' Al-Qur'aniyya</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Specialized Qur'anic recitation circles focusing on beautiful voice and correct recitation.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-100 border-t-[#0a3d62] border-t-[4px] shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
            <h3 class="text-xl font-bold text-[#0a3d62] mb-3">Teacher Qualification</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Training teachers with modern educational methods to raise a Qur'anic generation.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Image Slider -->
    <ImageSlider client:visible />

    <!-- Donation Section -->
    <section id="donate" class="py-20 md:py-28 bg-white relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#1a9a98]/20 to-transparent"></div>
      <div class="absolute inset-0 islamic-pattern opacity-[0.03]"></div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#8bc34a]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-5">
            <svg class="w-4 h-4 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
            </svg>
            Support the Qur'an
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">
            Donate to <span class="gradient-text">Itkan Academy</span>
          </h2>
          <p class="text-xl text-gray-500 leading-relaxed">
            Your donation enables us to teach more students and graduate memorizers of the Book of Allah. Every contribution makes a real difference in a child's life.
          </p>
        </div>
        <div class="bg-white rounded-3xl border border-gray-100 shadow-2xl overflow-hidden">
          <div class="bg-gradient-to-br from-[#0a3d62] to-[#0d4e7a] px-8 py-8 md:px-12 md:py-10 text-white text-center relative overflow-hidden">
            <div class="relative">
              <div class="w-16 h-16 mx-auto mb-5 bg-white/10 backdrop-blur-sm rounded-2xl flex items-center justify-center border border-white/20">
                <svg class="w-8 h-8 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold mb-3">Itkan Academy for Qur'an Memorization</h3>
              <p class="text-white/80 text-lg max-w-xl mx-auto">
                Support our educational programs and be the reason a hafiz of the Book of Allah graduates
              </p>
            </div>
          </div>
          <div class="px-6 py-8 md:px-12 md:py-10 text-center">

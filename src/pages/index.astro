---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import StatsSection from '../components/StatsSection.astro';
import About from '../components/About.astro';
import Objectives from '../components/Objectives.astro';
import Projects from '../components/Projects.astro';
import ImageSlider from '../components/ImageSlider.jsx';
import Testimonials from '../components/Testimonials.jsx';
import Areas from '../components/Areas.astro';
import Contact from '../components/Contact.astro';
import DonationSection from '../components/DonationSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout lang="ar">
  <Header lang="ar" />
  <main>
    <Hero />
    <About />
    <StatsSection />
    <VideoSection />
    <Objectives />
    <Projects />
    <Areas />
    <ImageSlider client:visible />
    <Testimonials client:visible />
    <DonationSection />
    <Contact />
  </main>
  <Footer />
</Layout>

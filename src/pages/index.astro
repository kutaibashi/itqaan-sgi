---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import About from '../components/About.astro';
import Objectives from '../components/Objectives.astro';
import Path from '../components/Path.astro';
import Voices from '../components/Voices.astro';
import Gallery from '../components/Gallery.astro';
import Areas from '../components/Areas.astro';
import Contact from '../components/Contact.astro';
import DonationSection from '../components/DonationSection.astro';
import Footer from '../components/Footer.astro';
import DonateModal from '../components/DonateModal.astro';
---

<Layout lang="ar">
  <Header lang="ar" />
  <main id="main">
    <Hero lang="ar" />
    <Path lang="ar" />
    <Areas lang="ar" />
    <Voices lang="ar" />
    <Gallery lang="ar" />
    <About />
    <VideoSection />
    <Objectives />
    <DonationSection />
    <Contact />
  </main>
  <Footer />
  <DonateModal />
</Layout>

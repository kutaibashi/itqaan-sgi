---
// Donation Section — Infaque Inline Widget
---

<section id="donate" class="py-20 md:py-28 bg-white relative overflow-hidden">
  <!-- Decorative top divider -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#1a9a98]/20 to-transparent"></div>

  <!-- Subtle background pattern -->
  <div class="absolute inset-0 islamic-pattern opacity-[0.03]"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 reveal">
      <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#8bc34a]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-5">
        <svg class="w-4 h-4 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
        </svg>
        ساهم في نشر القرآن
      </span>
      <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">
        تبرع لـ <span class="gradient-text">أكاديمية إتقان</span>
      </h2>
      <p class="text-xl text-gray-500 leading-relaxed">
        تبرعك يُمكننا من تعليم المزيد من الطلاب وحفظة كتاب الله. كل مساهمة تصنع فرقاً حقيقياً في حياة طفل أو طفلة.
      </p>
    </div>

    <!-- Donation Widget Card -->
    <div class="reveal reveal-delay-1 bg-white rounded-3xl border border-gray-100 shadow-2xl overflow-hidden">
      <!-- Card Header -->
      <div class="bg-gradient-to-br from-[#0a3d62] to-[#0d4e7a] px-8 py-8 md:px-12 md:py-10 text-white text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-48 h-48 bg-[#8bc34a]/15 rounded-full -translate-y-1/2 -translate-x-1/2 blur-2xl"></div>
        <div class="absolute bottom-0 right-0 w-32 h-32 bg-[#1a9a98]/20 rounded-full translate-y-1/2 translate-x-1/2 blur-xl"></div>
        <div class="relative">
          <div class="w-16 h-16 mx-auto mb-5 bg-white/10 backdrop-blur-sm rounded-2xl flex items-center justify-center border border-white/20">
            <svg class="w-8 h-8 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold mb-3">
            أكاديمية إتقان لتحفيظ القرآن الكريم
          </h3>
          <p class="text-white/80 text-lg max-w-xl mx-auto">
            ساهم في دعم برامجنا التعليمية وكن سبباً في تخريج حفظة كتاب الله
          </p>
        </div>
      </div>

      <!-- Donation Button -->
      <div class="px-6 py-8 md:px-12 md:py-10 text-center">
        <button
          id="donation-widget-1778468326670-yz11h-section"
          class="donation-widget donation-widget-button inline-flex items-center justify-center px-12 py-5 bg-[#8bc34a] text-[#0a3d62] font-black text-xl rounded-xl hover:bg-[#7cb342] transition-all duration-300 shadow-2xl hover:shadow-[#8bc34a]/30 transform hover:-translate-y-1 cursor-pointer"
          data-template-id="rcm86pmBCrlDhTbuU3tt"
          data-template-name="Itqaan Academy for Qur'an Memorization"
          data-tenant-id="bonyan-ngo"
          data-base-url="https://donate.sgi.ngo/donate-directly/contribution?cause=false&value=rcm86pmBCrlDhTbuU3tt&hideOtherCausesCampaigns=yes&header=no-header"
        >
          <svg class="w-6 h-6 ml-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
          </svg>
          تبرع الآن
        </button>
        <p class="text-gray-400 text-sm mt-4">
          اضغط على الزر لفتح نافذة التبرع بشكل آمن
        </p>
      </div>

      <!-- Trust Badges -->
      <div class="px-8 pb-8 md:px-12 md:pb-10">
        <div class="flex flex-wrap items-center justify-center gap-4 md:gap-8 pt-6 border-t border-gray-100">
          <div class="flex items-center gap-2 text-sm text-gray-500">
            <svg class="w-5 h-5 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
            </svg>
            <span>تبرع آمن ومحمي</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-500">
            <svg class="w-5 h-5 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>شفافية تامة في الصرف</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-500">
            <svg class="w-5 h-5 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span>100% يصل للمستحقين</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

---
// Contact Section
import SocialLinks from './SocialLinks.astro';
---

<section id="contact" class="py-20 md:py-28 bg-[#f8fafb] relative">
  <div class="absolute top-0 left-0 right-0 h-px border-t border-[#1a9a98]/20"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a9a98]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-4">
        تواصل معنا
      </span>
      <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">
        نحن هنا <span class="gradient-text">لخدمتك</span>
      </h2>
      <p class="text-xl text-gray-500">
        لا تتردد في التواصل معنا لأي استفسار أو للانضمام إلى برامجنا التعليمية.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
      
      <!-- Contact Cards -->
      <div class="space-y-4">
        <!-- Address -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 flex items-start gap-5 group">
          <div class="w-14 h-14 bg-gradient-to-br from-[#0a3d62]/10 to-[#1a9a98]/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-[#1a9a98]/10 group-hover:border-[#1a9a98]/30 transition-colors">
            <svg class="w-6 h-6 text-[#0a3d62]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-[#0a3d62] text-lg mb-1">المركز الرئيسي</h4>
            <p class="text-gray-500">تركيا - غازي عنتاب - كرتاش جانب جامع آمنة</p>
          </div>
        </div>

        <!-- Phone -->
        <a href="https://wa.me/905378980555" class="block bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 flex items-start gap-5 group">
          <div class="w-14 h-14 bg-gradient-to-br from-[#0a3d62]/10 to-[#1a9a98]/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-[#1a9a98]/10 group-hover:border-[#1a9a98]/30 group-hover:bg-gradient-to-br group-hover:from-[#0a3d62] group-hover:to-[#1a9a98] transition-all">
            <svg class="w-6 h-6 text-[#0a3d62] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-[#0a3d62] text-lg mb-1">رقم الهاتف</h4>
            <p class="text-[#1a9a98] font-bold text-lg group-hover:text-[#8bc34a] transition-colors ltr:text-right"><span dir="ltr" class="inline-block">+905378980555</span></p>
          </div>
        </a>

        <!-- Email -->
        <a href="mailto:info@itkan.info" class="block bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 flex items-start gap-5 group">
          <div class="w-14 h-14 bg-gradient-to-br from-[#0a3d62]/10 to-[#1a9a98]/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-[#1a9a98]/10 group-hover:border-[#1a9a98]/30 group-hover:bg-gradient-to-br group-hover:from-[#0a3d62] group-hover:to-[#1a9a98] transition-all">
            <svg class="w-6 h-6 text-[#0a3d62] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-[#0a3d62] text-lg mb-1">البريد الإلكتروني</h4>
            <p class="text-[#1a9a98] font-bold text-lg group-hover:text-[#8bc34a] transition-colors ltr:text-right">info@itkan.info</p>
          </div>
        </a>
      </div>

      <!-- CTA Card -->
      <div class=" bg-[#0a3d62] rounded-lg p-8 md:p-10 text-white flex flex-col justify-center relative overflow-hidden shadow-2xl">
        <div class="absolute top-0 left-0 w-48 h-48 bg-[#8bc34a]/15 rounded-full -translate-y-1/2 -translate-x-1/2 blur-2xl"></div>
        <div class="absolute bottom-0 right-0 w-32 h-32 bg-[#1a9a98]/20 rounded-full translate-y-1/2 translate-x-1/2 blur-xl"></div>
        <div class="relative">
          <h3 class="text-3xl font-bold mb-5">انضم إلينا اليوم</h3>
          <p class="text-white/80 mb-10 leading-relaxed text-lg">
            سواء كنت طالباً يسعى لتعلم القرآن، أو معلماً يرغب في التطوع، أو متبرعاً يريد دعم رسالتنا — نرحب بك في مؤسسة إتقان.
          </p>
          <div class="flex flex-col gap-3">
            <a href="https://wa.me/905378980555" class="inline-flex items-center justify-center w-full px-6 py-4 bg-[#8bc34a] text-[#0a3d62] font-bold text-lg rounded-xl hover:bg-[#7cb342] transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              تواصل معنا عبر واتساب
            </a>
            <a href="mailto:info@itkan.info" class="inline-flex items-center justify-center w-full px-6 py-4 border border-white/30 text-white font-semibold text-lg rounded-xl hover:bg-white/20 transition-all duration-300">
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              راسلنا عبر البريد
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Social Media Links -->
    <div class="mt-16 text-center">
      <p class="text-gray-400 text-sm mb-5 font-medium">تابعنا على وسائل التواصل الاجتماعي</p>
      <SocialLinks variant="contact" />
    </div>

  </div>
</section>

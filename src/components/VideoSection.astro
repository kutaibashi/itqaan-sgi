---
// Promo Video Section
const videoId = '9vrkcedB9LM';
const embedUrl = `https://www.youtube.com/embed/${videoId}?start=1&rel=0&modestbranding=1`;
---

<section class="py-20 md:py-28 bg-gradient-to-b from-white to-[#f8fafb] relative overflow-hidden">
  <!-- Decorative top divider -->
  <div class="absolute top-0 left-0 right-0 h-px border-t border-[#1a9a98]/20"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#1a9a98]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-5">
        <svg class="w-4 h-4 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
        </svg>
        شاهد المزيد
      </span>
      <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">
        تعرّف على <span class="gradient-text">مؤسسة إتقان</span>
      </h2>
      <p class="text-xl text-gray-500 leading-relaxed">
        شاهد هذا الفيديو التعريفي لتتعرف على رسالتنا ورؤيتنا وما نقدمه لطلابنا.
      </p>
    </div>

    <!-- Video Embed -->
    <div class=" relative rounded-lg overflow-hidden shadow-2xl bg-black border-4 border-white">
      <div class="relative w-full aspect-video">
        <iframe
          src={embedUrl}
          title="مؤسسة إتقان للتعليم والتنمية"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute inset-0 w-full h-full"
        ></iframe>
      </div>
    </div>

    <!-- YouTube Channel CTA -->
    <div class="mt-10 text-center">
      <a
        href="https://www.youtube.com/@ITKANDERNEGI"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        اشترك في قناتنا على يوتيوب
      </a>
    </div>

  </div>
</section>

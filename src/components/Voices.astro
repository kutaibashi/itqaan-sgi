---
import { voices, num } from '../data/itqaan';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';
const h2 = isEn ? 'In their students’ words' : 'بكلمات طلابها';
// Arabic separates with a comma: Readex draws '·' like the digit ٠.
const sep = isEn ? ' · ' : '، ';
const months = (m: number) => (isEn ? `${m} months at Itqaan` : `${num(m, lang)} شهرًا في إتقان`);
---
<section id="voices" class="section border-y border-line bg-white" aria-labelledby="voices-title">
  <div class="frame">
    <h2 id="voices-title" class="section-head reveal text-step-3">{h2}</h2>
    <div class="grid gap-10 md:grid-cols-3 md:gap-12">
      {voices.map((v, i) => (
        <figure class="reveal m-0" style={`--i:${i}`}>
          <span class="sq-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <blockquote class="m-0 mt-3 text-step-1 font-medium leading-relaxed">
            <p>{isEn ? `“${v.quote.en}”` : `«${v.quote.ar}»`}</p>
          </blockquote>
          <figcaption class="mt-4 border-t border-line pt-3 text-step--1 text-muted">
            <span class="font-semibold text-ink">{v.name[lang]}</span>{sep}{v.role[lang]}{sep}{months(v.months)}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

---
// Stats Section with animated counters
import StatsCounter from './StatsCounter.jsx';
---

<section class="relative bg-white -mt-8 z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-[#0a3d62] to-[#0d4e7a] rounded-3xl p-8 md:p-10 shadow-2xl relative overflow-hidden">
      <!-- Decorative -->
      <div class="absolute top-0 right-0 w-40 h-40 bg-[#8bc34a]/10 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl"></div>
      <div class="absolute bottom-0 left-0 w-32 h-32 bg-[#1a9a98]/15 rounded-full translate-y-1/2 -translate-x-1/2 blur-xl"></div>
      
      <StatsCounter client:visible />
    </div>
  </div>
</section>

---
// Distribution Areas Section
interface Props {
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const syriaAreasAr = [
  "ريف دمشق",
  "حلب وأريافها",
  "إدلب وأريافها",
  "مدينة حماة",
];

const turkeyAreasAr = [
  "مدينة إسطنبول",
  "مدينة عنتاب",
  "مدينة مرعش",
  "مدينة نيزب",
  "مدينة كلس",
];

const syriaAreasEn = [
  "Damascus Countryside",
  "Aleppo and its countryside",
  "Idlib and its countryside",
  "Hama City",
];

const turkeyAreasEn = [
  "Istanbul",
  "Gaziantep",
  "Kahramanmaras",
  "Nizip",
  "Kilis",
];

const syriaAreas = isEn ? syriaAreasEn : syriaAreasAr;
const turkeyAreas = isEn ? turkeyAreasEn : turkeyAreasAr;

const t = isEn ? {
  badge: "Our Reach",
  title1: "Areas of ",
  title2: "Distribution",
  desc: "Our programs reach students across Syria, Turkey, and online worldwide",
  syriaTitle: "Syria",
  syriaAreasCount: "4 areas",
  turkeyTitle: "Turkey",
  turkeyAreasCount: "5 cities",
  onlineTitle: "Online Center",
  onlineCount: "Worldwide",
  onlineDesc: "We reach students from all over the world through our educational online platform.",
  onlineBadge: "Students from all over the world"
} : {
  badge: "مناطق التوزع",
  title1: "نصل إلى ",
  title2: "كل مكان",
  desc: "نعمل في سوريا وتركيا، ونخدم الطلاب من كافة أنحاء العالم عبر مركزنا الإلكتروني.",
  syriaTitle: "سوريا",
  syriaAreasCount: "4 مناطق",
  turkeyTitle: "تركيا",
  turkeyAreasCount: "5 مدن",
  onlineTitle: "المركز الإلكتروني",
  onlineCount: "عالمياً",
  onlineDesc: "نصل إلى الطلاب من كافة أنحاء العالم عبر منصتنا الإلكترونية التعليمية.",
  onlineBadge: "الطلاب من كافة أنحاء العالم"
};
---

<section id="areas" class="py-20 md:py-28 bg-[#0a3d62] relative overflow-hidden">
  <!-- Islamic pattern overlay -->
  <div class="absolute inset-0 islamic-pattern opacity-100"></div>
  
  <!-- Decorative orbs -->
  <div class="absolute top-20 right-20 w-64 h-64 bg-[#1a9a98]/10 rounded-full "></div>
  <div class="absolute bottom-20 left-20 w-80 h-80 bg-[#8bc34a]/10 rounded-full "></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 text-[#8bc34a] text-sm font-bold rounded-full mb-4 border border-white/10">
        {t.badge}
      </span>
      <h2 class="text-4xl md:text-5xl font-black text-white mb-5">
        {t.title1}<span class="text-[#8bc34a]">{t.title2}</span>
      </h2>
      <p class="text-xl text-white/90">
        {t.desc}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Online -->
      <div class="lg:col-span-7 bg-gradient-to-br from-[#8bc34a]/20 to-[#1a9a98]/20 rounded-lg p-10 md:p-14 border border-[#8bc34a]/30 hover:border-[#8bc34a]/50 transition-all duration-500 group flex flex-col justify-center h-full">
        <div class="flex items-center gap-5 mb-10">
          <div class="w-16 h-16 bg-[#8bc34a] rounded-xl flex items-center justify-center shadow-lg shadow-[#8bc34a]/20">
            <svg class="w-8 h-8 text-[#0a3d62]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <h3 class="text-3xl font-bold text-white mb-2">{t.onlineTitle}</h3>
            <p class="text-white/80 font-medium">{t.onlineCount}</p>
          </div>
        </div>
        <p class="text-white/90 text-lg mb-10 leading-relaxed max-w-xl">
          {t.onlineDesc}
        </p>
        <div class="bg-white/10 rounded-2xl p-6 text-center border border-white/10 mt-auto">
          <div class="flex items-center justify-center gap-3 mb-3">
            <span class="text-4xl">🌍</span>
          </div>
          <p class="text-[#8bc34a] font-black text-xl">{t.onlineBadge}</p>
        </div>
      </div>

      <!-- Physical Locations (Syria & Turkey) -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        
        <!-- Syria -->
        <div class="flex-1 rounded-lg p-8 border border-white/10 hover:bg-white/15 transition-all duration-500 group">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-red-600/20 rounded-xl flex items-center justify-center border border-red-400/20">
              <svg class="w-6 h-6 text-red-300" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">{t.syriaTitle}</h3>
              <p class="text-white/80 text-sm">{t.syriaAreasCount}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-y-3 gap-x-4">
            {syriaAreas.map(area => (
              <div class="flex items-center gap-2 text-white/80 py-1">
                <div class="w-1.5 h-1.5 bg-[#8bc34a] rounded-full flex-shrink-0"></div>
                <span class="font-medium text-sm">{area}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Turkey -->
        <div class="flex-1 rounded-lg p-8 border border-white/10 hover:bg-white/15 transition-all duration-500 group">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center border border-red-300/20">
              <svg class="w-6 h-6 text-red-200" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">{t.turkeyTitle}</h3>
              <p class="text-white/80 text-sm">{t.turkeyAreasCount}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-y-3 gap-x-4">
            {turkeyAreas.map(area => (
              <div class="flex items-center gap-2 text-white/80 py-1">
                <div class="w-1.5 h-1.5 bg-[#8bc34a] rounded-full flex-shrink-0"></div>
                <span class="font-medium text-sm">{area}</span>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

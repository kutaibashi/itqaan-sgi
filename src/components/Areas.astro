---
/**
 * Where Itqaan teaches: a schematic map beside the lists.
 *
 * The map places each city at its real latitude/longitude (a plain
 * equirectangular projection over the Syria–Türkiye border region), with faint
 * graticule lines and deliberately NO borders — drawing borders would mean
 * taking positions on disputed geography. Istanbul is far off to the west, so
 * it appears as a pointer off the map's edge. Geography is never mirrored for
 * RTL. The lists are the real content; the map is a labelled illustration.
 */
import { areas, onlineReadingGraduates, formatCount, num, type Area } from '../data/itqaan';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const t = isEn
  ? {
      h2: 'Where Itqaan teaches',
      syria: 'Syria', syriaCount: `${num(areas.syria.length, lang)} areas`,
      turkey: 'Türkiye', turkeyCount: `${num(areas.turkey.length, lang)} cities`,
      online: 'Online centre', onlineCount: 'worldwide',
      onlineItems: ['Online circles for students anywhere in the world', `${formatCount(onlineReadingGraduates, lang)} online graduates of Bil-Qira’ah Nahya`],
      mapLabel: 'Schematic map: Itqaan’s centres in northern Syria and southern Türkiye, linked to its headquarters in Gaziantep, with Istanbul off the map to the west',
      istanbul: 'Istanbul',
      west: 'to the west',
      hq: 'Headquarters',
    }
  : {
      h2: 'أين تنتشر حلقات إتقان',
      syria: 'سوريا', syriaCount: `${num(areas.syria.length, lang)} مناطق`,
      turkey: 'تركيا', turkeyCount: `${num(areas.turkey.length, lang)} مدن`,
      online: 'المركز الإلكتروني', onlineCount: 'عالميًا',
      onlineItems: ['حلقات عبر الإنترنت لطلاب من أنحاء العالم', `${formatCount(onlineReadingGraduates, lang)} خرّيج في «بالقراءة نحيا» عبر الإنترنت`],
      mapLabel: 'خريطة تقريبية: مراكز إتقان في شمال سوريا وجنوب تركيا، مرتبطة بمركزها الرئيسي في غازي عنتاب، وإسطنبول غربًا خارج حدود الخريطة',
      istanbul: 'إسطنبول',
      west: 'غربًا',
      hq: 'المركز الرئيسي',
    };

// Projection over lon 35.6–38.4, lat 33–37.9 (1° lat = 100 units, 1° lon = 80 ≈ cos 37°).
const X = (lon: number) => Math.round((lon - 35.6) * 80 + 24);
const Y = (lat: number) => Math.round((37.9 - lat) * 100 + 28);
const W = 300, H = 500;

const onMap = (a: Area) => a.lon > 35;
const cityName = (a: Area) => (a[lang] as string).replace(/\s*\((المركز الرئيسي|headquarters)\)/, '').replace(/ وأريافها| and its countryside|مدينة /g, '').replace(/ \(Damascus countryside\)/, '');
// Label side per city, to keep the dense cluster readable.
const leftLabels = new Set([37.07, 35.93, 36.72]); // Gaziantep, Idlib, Kilis

const hq = areas.turkey.find((a) => a.hq)!;
const hx = X(hq.lon), hy = Y(hq.lat);
const cities = [
  ...areas.turkey.filter(onMap).map((a) => ({ a, country: 'tr' as const })),
  ...areas.syria.map((a) => ({ a, country: 'sy' as const })),
];
const graticule = { lons: [36, 37, 38], lats: [34, 35, 36, 37] };

const columns = [
  { key: 'sy', title: t.syria, count: t.syriaCount, items: areas.syria.map((a) => a[lang]) },
  { key: 'tr', title: t.turkey, count: t.turkeyCount, items: areas.turkey.map((a) => a[lang]) },
];
---
<section id="areas" class="section" aria-labelledby="areas-title">
  <div class="frame">
    <h2 id="areas-title" class="section-head reveal text-step-3">{t.h2}</h2>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,23rem)_1fr] lg:gap-16">
      <figure class="reveal m-0 rounded-lg border border-line bg-white p-4 sm:p-5">
        <svg class="areas-map block h-auto w-full" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.mapLabel}>
          <g class="map-grid">
            {graticule.lons.map((lon) => <line x1={X(lon)} y1="8" x2={X(lon)} y2={H - 8} />)}
            {graticule.lats.map((lat) => <line x1="8" y1={Y(lat)} x2={W - 8} y2={Y(lat)} />)}
            {graticule.lats.map((lat) => <text x={W - 10} y={Y(lat) - 4} text-anchor="end" direction="ltr">{`${lat}°`}</text>)}
          </g>

          {/* Istanbul: a pointer off the north-west edge, joined to headquarters. */}
          <g class="map-offmap">
            <line class="map-link" x1={hx} y1={hy} x2="30" y2="30" style={`transform-origin:${hx}px ${hy}px`} />
            <path d="M40 22 22 22 22 40M22 22 34 34" />
            <text x="46" y="26" direction="ltr">{t.istanbul}</text>
            <text class="map-note" x="46" y="40" direction="ltr">{t.west}</text>
          </g>

          {cities.filter((c) => !c.a.hq).map((c, i) => (
            <line class="map-link" x1={hx} y1={hy} x2={X(c.a.lon)} y2={Y(c.a.lat)} style={`transform-origin:${hx}px ${hy}px;--i:${i}`} />
          ))}

          {cities.map((c, i) => {
            const x = X(c.a.lon), y = Y(c.a.lat), left = leftLabels.has(c.a.lat);
            return (
              <g class:list={['map-city', `map-city--${c.country}`, c.a.hq && 'map-city--hq']} style={`--i:${i}`}>
                {c.a.hq && <circle class="map-hq-ring" cx={x} cy={y} r="13" />}
                <circle cx={x} cy={y} r={c.a.hq ? 7 : 5.5} />
                <text x={left ? x - 13 : x + 13} y={y + 5} text-anchor={left ? 'end' : 'start'} direction="ltr">{cityName(c.a)}</text>
                {c.a.hq && <text class="map-note" x={x - 13} y={y + 21} text-anchor="end" direction="ltr">{t.hq}</text>}
              </g>
            );
          })}
        </svg>
      </figure>

      <div class="grid content-start gap-10 sm:grid-cols-2 sm:gap-12">
        {columns.map((c, i) => (
          <div class="reveal" style={`--i:${i + 1}`}>
            <h3 class="flex items-baseline justify-between border-b-2 border-ink pb-2 text-step-1">
              <span class="flex items-center gap-2"><i class:list={['areas-key', `areas-key--${c.key}`]} aria-hidden="true"></i>{c.title}</span>
              <span class="text-step--1 font-semibold text-teal-text">{c.count}</span>
            </h3>
            <ul class="m-0 list-none p-0">
              {c.items.map((item) => <li class="border-b border-line py-2.5">{item}</li>)}
            </ul>
          </div>
        ))}
        <div class="reveal rounded-lg bg-white p-5 sm:col-span-2" style="--i:3">
          <h3 class="flex items-baseline justify-between text-step-1">
            {t.online}<span class="text-step--1 font-semibold text-teal-text">{t.onlineCount}</span>
          </h3>
          <ul class="m-0 mt-2 list-none p-0 text-muted">
            {t.onlineItems.map((item) => <li class="py-1">{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .areas-map { font-family: var(--font-sans); overflow: visible; }
  .map-grid line { stroke: var(--color-line); stroke-width: 1; stroke-dasharray: 3 4; }
  .map-grid text { font-size: 9px; fill: var(--color-muted); }
  .map-link { stroke: var(--color-teal); stroke-width: 1.8; stroke-linecap: round; opacity: 0.6; }
  .map-offmap .map-link { stroke-dasharray: 4 5; }
  .map-offmap path { fill: none; stroke: var(--color-ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .map-offmap text, .map-city text { font-size: 14px; font-weight: 700; fill: var(--color-ink); paint-order: stroke; stroke: white; stroke-width: 4px; stroke-linejoin: round; }
  .map-note { font-size: 11px !important; font-weight: 400 !important; fill: var(--color-muted) !important; }
  .map-city circle { stroke: white; stroke-width: 2; }
  .map-city--tr circle { fill: var(--color-teal); }
  .map-city--sy circle { fill: var(--color-ink); }
  .map-city--hq circle { fill: var(--color-teal-text); }
  .map-city .map-hq-ring { fill: none; stroke: var(--color-lime); stroke-width: 2.5; }

  .areas-key { display: inline-block; inline-size: 0.6rem; block-size: 0.6rem; border-radius: 50%; }
  .areas-key--tr { background: var(--color-teal); }
  .areas-key--sy { background: var(--color-ink); }

  /* Motion: links grow out from headquarters, then the cities appear. Hidden
     only under .js (set by the reveal script), so without JS the map is complete. */
  :global(.js) .map-link { transform: scale(0); transition: transform 900ms var(--ease-out); transition-delay: calc(250ms + var(--i, 0) * 80ms); }
  :global(.js) .map-city { opacity: 0; transition: opacity 500ms var(--ease-out); transition-delay: calc(600ms + var(--i, 0) * 80ms); }
  :global(.js) .map-offmap { opacity: 0; transition: opacity 600ms var(--ease-out) 900ms; }
  :global(.js) .reveal.is-in .map-link { transform: none; }
  :global(.js) .reveal.is-in .map-city,
  :global(.js) .reveal.is-in .map-offmap { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .map-link { transform: none; transition: none; }
  }
</style>

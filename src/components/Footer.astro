---
// Footer Component
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const t = isEn ? {
  desc: "A pioneering reference foundation contributing to building a generation and advancing society.",
  about: "About",
  projects: "Programs",
  areas: "Locations",
  contact: "Contact",
  rights: `© ${new Date().getFullYear()} Itkan Foundation for Education and Development. All rights reserved.`,
  licensed: "Licensed Foundation - Syria & Turkey"
} : {
  desc: "مؤسسة مرجعية رائدة تسهم في بناء الجيل ونهضة المجتمع.",
  about: "عن المؤسسة",
  projects: "مشاريعنا",
  areas: "مناطق التوزع",
  contact: "تواصل معنا",
  rights: `© ${new Date().getFullYear()} مؤسسة إتقان للتعليم والتنمية. جميع الحقوق محفوظة.`,
  licensed: "مؤسسة مرخصة في سوريا وتركيا"
};
---

<footer class="bg-[#072a40] text-white border-t-[6px] border-[#0a3d62]">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-10">
      
      <!-- Brand -->
      <div class={`text-center ${isEn ? 'md:text-left' : 'md:text-right'}`}>
        <div class={`flex items-center gap-3 justify-center ${isEn ? 'md:justify-start' : 'md:justify-start'} mb-4`}>
          <div class="bg-white rounded-md px-2 py-1.5 shadow-sm">
            <img src="/logo.png" alt="Itkan" class="h-12 w-auto" width="190" height="102" />
          </div>
        </div>
        <p class="text-white/80 text-sm max-w-sm leading-relaxed font-heading">
          {t.desc}
        </p>
        <SocialLinks variant="footer" />
      </div>
      
      <!-- Quick Links -->
      <div class="flex flex-wrap items-center justify-center gap-8 text-sm">
        <a href="#about" class="text-white/90 hover:text-[#8bc34a] transition-colors font-medium">{t.about}</a>
        <a href="#projects" class="text-white/90 hover:text-[#8bc34a] transition-colors font-medium">{t.projects}</a>
        <a href="#areas" class="text-white/90 hover:text-[#8bc34a] transition-colors font-medium">{t.areas}</a>
        <a href="#contact" class="text-white/90 hover:text-[#8bc34a] transition-colors font-medium">{t.contact}</a>
      </div>
      
    </div>
    
    <!-- Divider -->
    <div class="border-t border-[#1a9a98]/20 my-10"></div>
    
    <!-- Bottom -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-white/80">
      <p>{t.rights}</p>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#1a9a98]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>{t.licensed}</span>
      </div>
    </div>
    
  </div>
</footer>

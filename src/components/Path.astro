---
/**
 * The signature: a student's path through Itqaan, drawn as a chain (سند) —
 * one line, one node per programme, ending at the ijaza. Nodes, not shrinking
 * bars: each stage is its own longer programme with its own students, and bars
 * would read as dropout.
 *
 * Set on a navy band over faint rows of prayer-carpet arches — the rows the
 * students sit in. The line draws itself with scroll where the browser has
 * scroll-driven animations; everywhere else it is simply there.
 */
import LinkArrow from './LinkArrow.astro';
import { programmes, ijazaLine, teacherTraining, formatCount, countPrefix, num, roundDown, DATA_SOURCE } from '../data/itqaan';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const t = isEn
  ? {
      h2: 'A long road, walked with each student one step at a time',
      intro: 'A child starts with the alphabet at five. Some continue for years, until they receive an ijaza: a teacher’s certification to recite and teach the Qur’an. Each stage is longer and deeper than the one before, and each has its own students.',
      source: 'Graduates since each programme began, as published by Itqaan, rounded down.',
      track: 'places taken in teacher-training courses, by men and women aged 18 and over who teach the next circles.',
      give: 'Help keep this road open',
    }
  : {
      h2: 'طريقٌ طويل، نقطعه مع الطالب خطوةً خطوة',
      intro: 'يبدأ الأطفال بالحروف في الخامسة، ويواصل بعضهم سنواتٍ حتى ينالوا إجازةً في القرآن الكريم. كل مرحلةٍ أطول وأعمق من التي قبلها، ولكلٍّ منها طلابها.',
      source: 'أعداد الخرّيجين منذ انطلاق كل برنامج، كما تنشرها مؤسسة إتقان، مقرّبةً إلى الأقلّ لا إلى الأكثر.',
      track: 'مشاركة في دورات تأهيل الكوادر التعليمية، لمعلّمين ومعلّمات من عمر 18 سنة فما فوق، سيعلّمون في الحلقات القادمة.',
      give: 'ساهم في إبقاء هذا الطريق مفتوحًا',
    };
---
<section id="path" class="path arch-rows on-dark section relative isolate overflow-hidden bg-ink text-white" aria-labelledby="path-title">
  <div class="frame grid gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
    <div class="reveal lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
      <h2 id="path-title" class="text-step-3">{t.h2}</h2>
      <p class="mt-5 max-w-[46ch] text-white/85">{t.intro}</p>
      <p class="mt-5 text-step--1 text-white/70">{t.source} (<bdi>{DATA_SOURCE.url}</bdi>)</p>
    </div>

    <div>
      <ol class="chain">
        {programmes.map((p, i) => (
          <li class="chain-step reveal" style={`--i:${i}`}>
            <span class="chain-dot" aria-hidden="true">{num(i + 1, lang)}</span>
            {/* Heading first in source, so a screen reader moving by headings hears
                each count after its programme name; CSS places the count first. */}
            <div class="chain-body">
              <h3 class="text-step-1">{p.name[lang]}</h3>
              <p class="mt-1 text-step--1 text-white/80">{p.teaches[lang]}</p>
              <p class="mt-1 text-step--1 text-white/65">{p.meta[lang]}</p>
            </div>
            <p class="chain-count">
              <span class="chain-count-note">{countPrefix(p.count, lang)}</span>
              <span class="chain-count-num">{num(roundDown(p.count), lang)}</span>
              <span class="chain-count-note">{p.countLabel[lang]}</span>
            </p>
          </li>
        ))}
        <li class="chain-step chain-end reveal" style="--i:4">
          <span class="chain-dot" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          {/* Amiri for the Arabic line only; English spells the honorific out. */}
          <p class:list={['chain-ijaza', !isEn && 'font-quran']}>{ijazaLine[lang]}</p>
        </li>
      </ol>

      <p class="reveal mt-10 flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-md border border-white/15 bg-white/[0.06] px-5 py-4 text-step--1 text-white/85">
        <strong class="text-step-2 font-semibold text-white tabular-nums">{formatCount(teacherTraining.count, lang)}</strong>
        <span>{t.track}</span>
      </p>

      <p class="reveal mt-8"><a href="#donate" class="link-quiet text-white">{t.give}<LinkArrow to="down" /></a></p>
    </div>
  </div>
</section>

<style>
  .chain { list-style: none; margin: 0; padding: 0; position: relative; }
  /* The سند itself: one continuous line through every node. */
  .chain::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(1rem - 1px);
    inset-block: 1.75rem 2rem;
    inline-size: 2px;
    background: linear-gradient(var(--color-teal), var(--color-lime));
    transform-origin: top;
  }
  .chain-step {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    align-items: start;
    padding-block: 1.5rem;
    border-block-end: 1px solid color-mix(in oklch, white 12%, transparent);
  }
  .chain-dot {
    grid-column: 1; grid-row: 1;
    position: relative; z-index: 1;
    display: grid; place-items: center;
    inline-size: 2rem; block-size: 2rem;
    border-radius: 50%;
    border: 2px solid var(--color-teal);
    background: var(--color-ink);
    color: var(--color-lime);
    font-size: var(--text-step--2);
    font-weight: 700;
  }
  .chain-count { grid-column: 2; grid-row: 1; margin: 0; display: flex; flex-direction: column; line-height: 1.15; }
  .chain-count-num { font-size: var(--text-step-4); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .chain-count-note { font-size: var(--text-step--1); color: color-mix(in oklch, white 72%, transparent); }
  .chain-body { grid-column: 2; grid-row: 2; }
  .chain-end { border-block-end: 0; align-items: center; padding-block-end: 0; }
  .chain-end .chain-dot { background: var(--color-lime); border-color: var(--color-lime); color: var(--color-ink-deep); }
  .chain-ijaza { grid-column: 2; margin: 0; font-size: var(--text-step-2); font-weight: 700; line-height: 1.5; }

  /* From 40rem the count gets its own column: dot · count · programme. */
  @media (min-width: 40rem) {
    .chain-step { grid-template-columns: 2rem 12.5rem 1fr; column-gap: 1.75rem; align-items: center; }
    .chain-body { grid-column: 3; grid-row: 1; }
    .chain-end .chain-ijaza { grid-column: 2 / -1; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes chain-draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
      .chain::before { animation: chain-draw linear both; animation-timeline: view(); animation-range: entry 15% cover 55%; }
    }
  }
</style>

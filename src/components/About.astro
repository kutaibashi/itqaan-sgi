---
// About Section: Vision, Values, Mission
const values = [
  { title: "الإتقان", desc: "الإتقان في العمل والتعليم، كما قال النبي ﷺ: إن الله يحب إذا عمل أحدكم عملاً أن يتقنه", icon: "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" },
  { title: "القدوة", desc: "نكون قدوة حسنة في التعليم والأخلاق لأبنائنا وبناتنا", icon: "M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" },
  { title: "الإسناد", desc: "إسناد الطلاب والكوادر التعليمية بكل ما يحتاجونه للنجاح", icon: "M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" },
  { title: "الأمان", desc: "توفير بيئة تعليمية آمنة ومحفزة لجميع الطلاب", icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
];
---

<section id="about" class="py-20 md:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 reveal">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a9a98]/10 text-[#0a3d62] text-sm font-bold rounded-full mb-4">
        عن المؤسسة
      </span>
      <h2 class="text-4xl md:text-5xl font-black text-[#0a3d62] mb-5">
        من نحن؟
      </h2>
      <p class="text-xl text-gray-500 leading-relaxed">
        مؤسسة مرجعية رائدة تسهم في بناء الجيل، ونهضة المجتمع.
      </p>
    </div>

    <!-- Vision & Mission Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-20">
      
      <!-- Vision -->
      <div class="reveal reveal-delay-1 bg-gradient-to-br from-[#0a3d62] to-[#0d4e7a] rounded-3xl p-10 md:p-12 text-white relative overflow-hidden group hover:shadow-2xl transition-all duration-500">
        <div class="absolute top-0 right-0 w-48 h-48 bg-[#8bc34a]/15 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-[#1a9a98]/20 rounded-full translate-y-1/2 -translate-x-1/2 blur-xl"></div>
        <div class="relative">
          <div class="w-16 h-16 bg-white/15 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-8 border border-white/10">
            <svg class="w-8 h-8 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
              <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="text-3xl font-bold mb-5">رؤيتنا</h3>
          <p class="text-white/85 text-xl leading-relaxed">
            مؤسسة مرجعية رائدة تسهم في بناء الجيل، ونهضة المجتمع.
          </p>
        </div>
      </div>

      <!-- Mission -->
      <div class="reveal reveal-delay-2 bg-gradient-to-br from-[#f0f7f7] to-white rounded-3xl p-10 md:p-12 border-2 border-[#1a9a98]/15 hover:border-[#1a9a98]/40 transition-all duration-500 group hover:shadow-xl">
        <div class="w-16 h-16 bg-[#0a3d62] rounded-2xl flex items-center justify-center mb-8 shadow-lg">
          <svg class="w-8 h-8 text-[#8bc34a]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
          </svg>
        </div>
        <h3 class="text-3xl font-bold text-[#0a3d62] mb-5">رسالتنا</h3>
        <p class="text-gray-500 text-xl leading-relaxed">
          مؤسسة تعليمية تهتم بتعليم العربية السليمة، وضبط القرآن الكريم وحفظه،
          والتربية على قيمه ومبادئه؛ لإخراج جيل واعٍ يسهم في نهضة المجتمع ورقيه.
        </p>
      </div>
    </div>

    <!-- Values -->
    <div class="reveal">
      <h3 class="text-3xl font-bold text-center text-[#0a3d62] mb-14">قيمنا</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((value, i) => (
          <div class={`reveal reveal-delay-${i + 1} bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-xl hover:border-[#1a9a98]/30 transition-all duration-500 text-center group hover:-translate-y-2`}>
            <div class="w-14 h-14 mx-auto mb-5 bg-gradient-to-br from-[#f0f7f7] to-white rounded-xl flex items-center justify-center border border-[#1a9a98]/20 group-hover:border-[#1a9a98]/50 group-hover:from-[#1a9a98]/10 group-hover:to-[#8bc34a]/10 transition-all">
              <svg class="w-7 h-7 text-[#0a3d62] group-hover:text-[#1a9a98] transition-colors" fill="currentColor" viewBox="0 0 20 20">
                <path d={value.icon} />
              </svg>
            </div>
            <h4 class="text-xl font-bold text-[#0a3d62] mb-3">{value.title}</h4>
            <p class="text-sm text-gray-500 leading-relaxed">{value.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

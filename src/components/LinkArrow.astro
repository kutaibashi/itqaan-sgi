---
/** A small arrow that says where a link goes: down the page, or out to another site. */
interface Props { to: 'down' | 'out'; }
const { to } = Astro.props;
---
<svg class:list={['link-arrow', `link-arrow--${to}`]} viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
  {to === 'down'
    ? <path d="M8 3v9M4 8.5 8 12.5l4-4" />
    : <path d="M5 11 11 5M6 5h5v5" />}
</svg>

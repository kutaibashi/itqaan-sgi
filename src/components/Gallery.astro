---
/**
 * Four photos from Itqaan's circles, each opening full size.
 *
 * Every photo is a plain link to its 1600px file, so without JavaScript it
 * still opens. With JavaScript, a native <dialog> viewer takes over:
 * previous/next (buttons and arrow keys, following reading direction), Esc to
 * close, focus back on the photo that opened it. No library.
 *
 * No visible captions; each photo's alt text describes only what is visible.
 */
import Picture from './Picture.astro';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const t = isEn
  ? { h2: 'Inside the circles', viewer: 'Photo viewer', close: 'Close', prev: 'Previous photo', next: 'Next photo', open: 'Open photo' }
  : { h2: 'من داخل الحلقات', viewer: 'عارض الصور', close: 'إغلاق', prev: 'الصورة السابقة', next: 'الصورة التالية', open: 'افتح الصورة' };

const photos = [
  { name: 'lecture', caption: isEn ? 'A lesson for young men, with a projector, inside a mosque' : 'درس لشباب أمام شاشة عرض داخل مسجد' },
  { name: 'women', caption: isEn ? 'A women’s circle reading the Qur’an on wooden stands' : 'حلقة نسائية تقرأ القرآن على الرحلات' },
  { name: 'classroom', caption: isEn ? 'Children writing in a classroom at a learning centre' : 'أطفال يكتبون في صفّ داخل مركز تعليمي' },
  { name: 'teachers', caption: isEn ? 'Adult men in a classroom during a course' : 'رجال في قاعة دراسية خلال دورة' },
] as const;
---
<section id="photos" class="section" aria-labelledby="photos-title">
  <div class="frame">
    <h2 id="photos-title" class="section-head reveal text-step-3">{t.h2}</h2>
    <div class="grid grid-cols-2 gap-2 md:grid-cols-4 md:grid-rows-[repeat(2,15rem)] md:gap-3">
      {photos.map((p, i) => (
        <figure class:list={['gallery-item reveal m-0', i === 0 && 'col-span-2 md:row-span-2', i === 3 && 'col-span-2']} style={`--i:${i}`}>
          <a
            href={`/photos/${p.name}-1600.webp`}
            class="gallery-link group"
            data-lightbox={i}
            data-caption={p.caption}
            aria-label={`${t.open}: ${p.caption}`}
          >
            <Picture
              name={p.name}
              alt={p.caption}
              sizes={i === 0 || i === 3 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
              class="gallery-img size-full object-cover"
            />
            <span class="gallery-zoom" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="16" height="16"><path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9" /></svg>
            </span>
          </a>
        </figure>
      ))}
    </div>
  </div>

  <dialog class="lightbox" aria-label={t.viewer} data-lb>
    <figure class="lightbox-figure m-0">
      <img class="lightbox-img" alt="" width="1600" height="1216" decoding="async" data-lb-img />
    </figure>
    <p class="lightbox-count" aria-live="polite" data-lb-count></p>
    <button type="button" class="lightbox-btn lightbox-btn--close" data-lb-close aria-label={t.close}>
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13" /></svg>
    </button>
    <button type="button" class="lightbox-btn lightbox-btn--prev" data-lb-prev aria-label={t.prev}>
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
    </button>
    <button type="button" class="lightbox-btn lightbox-btn--next" data-lb-next aria-label={t.next}>
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
    </button>
  </dialog>
</section>

<style>
  .gallery-item { position: relative; overflow: hidden; border-radius: 0.375rem; }
  .gallery-link { display: block; block-size: 100%; }
  .gallery-img { transition: transform 700ms var(--ease-out); }
  .gallery-zoom {
    position: absolute; inset-block-start: 0.6rem; inset-inline-end: 0.6rem;
    display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem;
    border-radius: 50%; background: color-mix(in oklch, white 92%, transparent); color: var(--color-ink);
    opacity: 0; transform: scale(0.85); transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .gallery-zoom svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) {
    .gallery-item:hover .gallery-img { transform: scale(1.04); }
    .gallery-item:hover .gallery-zoom { opacity: 1; transform: none; }
  }
  .gallery-link:focus-visible { outline-offset: -4px; outline-color: var(--color-surface); }
  .gallery-item:focus-within .gallery-zoom { opacity: 1; transform: none; }
  /* Touch screens can't hover: always show the zoom affordance. */
  @media (hover: none) { .gallery-zoom { opacity: 1; transform: none; } }

  /* Full screen: the photo gets all of it, on phones especially. */
  .lightbox {
    inline-size: 100vw; block-size: 100svh; max-inline-size: 100vw; max-block-size: 100svh;
    margin: 0; padding: 0; border: 0; background: transparent; color: var(--color-surface); overflow: hidden;
  }
  .lightbox::backdrop { background: color-mix(in oklch, var(--color-ink-deep) 97%, transparent); }
  .lightbox[open] { animation: lb-in 300ms var(--ease-out); }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } }
  .lightbox-figure { display: grid; place-content: center; justify-items: center; gap: 0.9rem; block-size: 100%; padding: 4rem 1rem 1.5rem; max-inline-size: 72rem; margin-inline: auto; }
  .lightbox-img { max-block-size: calc(100svh - 10rem); inline-size: auto; max-inline-size: 100%; border-radius: 0.375rem; transition: opacity 200ms var(--ease-out); }
  .lightbox-img.is-swapping { opacity: 0; }
  .lightbox-count { position: absolute; inset-block-start: 1.25rem; inset-inline-start: 1.25rem; margin: 0; font-size: var(--text-step--1); color: color-mix(in oklch, white 75%, transparent); font-variant-numeric: tabular-nums; }
  .lightbox-btn {
    position: absolute; display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem;
    border: 0; border-radius: 50%; cursor: pointer; color: var(--color-surface);
    background: color-mix(in oklch, white 14%, transparent);
    transition: background-color 150ms var(--ease-out), transform 150ms var(--ease-out);
    --focus-ring: var(--color-lime);
  }
  .lightbox-btn svg { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) { .lightbox-btn:hover { background: color-mix(in oklch, white 26%, transparent); } }
  .lightbox-btn:active { transform: scale(0.94); }
  .lightbox-btn--close { inset-block-start: 0.75rem; inset-inline-end: 0.75rem; }
  .lightbox-btn--prev, .lightbox-btn--next { inset-block-start: 45%; }
  .lightbox-btn--prev { inset-inline-start: 0.5rem; }
  .lightbox-btn--next { inset-inline-end: 0.5rem; }
  /* Chevrons point along the reading direction. */
  :global([dir='rtl']) .lightbox-btn--prev svg, :global([dir='rtl']) .lightbox-btn--next svg { scale: -1 1; }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] { animation: none; }
    .gallery-img, .gallery-zoom { transition: opacity 200ms linear; }
    .gallery-item:hover .gallery-img { transform: none; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lb]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
  if (dialog && typeof dialog.showModal === 'function' && links.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const rtl = document.documentElement.dir === 'rtl';
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.classList.add('is-swapping');
      const next = new Image();
      next.src = link.href;
      next.decode().catch(() => {}).finally(() => {
        img.src = link.href;
        img.alt = link.dataset.caption ?? '';
        // Words, not a slash: in RTL "1 / 4" would render reversed as "4 / 1".
        count.textContent = rtl ? `${index + 1} من ${links.length}` : `${index + 1} of ${links.length}`;
        img.classList.remove('is-swapping');
      });
    };

    links.forEach((link, i) => link.addEventListener('click', (event) => {
      // Modified clicks keep their meaning: open the file in a new tab.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      opener = link;
      show(i);
      dialog.showModal();
    }));

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (event) => {
      // Arrow keys follow reading direction: in Arabic, left is "next".
      if (event.key === 'ArrowRight') show(index + (rtl ? -1 : 1));
      if (event.key === 'ArrowLeft') show(index + (rtl ? 1 : -1));
    });
    // A click on the backdrop (the dialog itself, outside the figure) closes.
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

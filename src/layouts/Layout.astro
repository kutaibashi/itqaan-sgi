---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const defaultTitle = isEn 
  ? "Itkan Foundation for Education and Development" 
  : "مؤسسة إتقان للتعليم والتنمية";

const defaultDesc = isEn
  ? "Itkan is an educational foundation dedicated to teaching proper Arabic, Qur'an recitation, memorization, and nurturing values derived from the Qur'an."
  : "مؤسسة إتقان للتعليم والتنمية - مؤسسة تعليمية تهتم بتعليم العربية السليمة، وضبط القرآن الكريم وحفظه، والتربية على قيمه ومبادئه.";

const {
  title = defaultTitle,
  description = defaultDesc,
} = Astro.props;

const siteUrl = "https://itqaan.sgi.ngo";
const siteName = isEn ? "Itkan Foundation" : "مؤسسة إتقان";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": defaultTitle,
  "url": siteUrl,
  "description": defaultDesc,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+905378980555",
    "email": "info@itkan.info",
    "contactType": isEn ? "Information" : "معلومات",
    "availableLanguage": isEn ? ["English", "Arabic"] : ["Arabic", "English"]
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "TR",
    "addressLocality": isEn ? "Gaziantep" : "غازي عنتاب",
    "streetAddress": isEn ? "Kartaş, next to Aminah Mosque" : "كرتاش جانب جامع آمنة"
  }
};
---

<!DOCTYPE html>
<html lang={lang} dir={isEn ? 'ltr' : 'rtl'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={isEn ? "Itkan, Quran teaching, Quran memorization, Arabic teaching, Syria, Turkey, charity" : "إتقان, تعليم القرآن, حفظ القرآن, تعليم العربية, سوريا, تركيا, مؤسسة خيرية"} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {isEn ? (
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    ) : (
      <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    )}
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)}></script>

    {/*
      Donations are SGI's own checkout, opened in a modal iframe by
      components/DonateModal.astro. There is no third-party donation script here any
      more, and nothing to bootstrap from <head>.

      What was here until 2026-08-19: four Infaque widget files, self-hosted from
      /public/infaque/ because on 2026-08-17 Infaque deleted them from their CDN.
      Firebase Hosting's catch-all rewrite answered 200 with their SPA shell as
      text/html, Chrome refused it (net::ERR_BLOCKED_BY_ORB), and every donate button
      on this site went dead — silently, because a 200 is not an error. The pinned
      Wayback copies were always a bridge, not a fix.

      The replacement is documented on the SGI side, in the theme at
      docs/itqaan-embed.md, which also owns the URL contract these buttons rely on.
      Config lives in src/config/donate.ts — not in per-button data attributes.
    */}
  </head>
  <body class="bg-white">
    <slot />
  </body>
</html>

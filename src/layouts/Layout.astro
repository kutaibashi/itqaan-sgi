---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ar' | 'en';
}

const {
  title = "مؤسسة إتقان للتعليم والتنمية",
  description = "مؤسسة إتقان للتعليم والتنمية - مؤسسة تعليمية تهتم بتعليم العربية السليمة، وضبط القرآن الكريم وحفظه، والتربية على قيمه ومبادئه.",
  lang = 'ar'
} = Astro.props;

const siteUrl = "https://itqaan.sgi.ngo";
const isEn = lang === 'en';
---

<!DOCTYPE html>
<html lang={lang} dir={isEn ? 'ltr' : 'rtl'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={isEn ? "Itkan, Quran teaching, Quran memorization, Arabic teaching, Syria, Turkey, charity" : "إتقان, تعليم القرآن, حفظ القرآن, تعليم العربية, سوريا, تركيا, مؤسسة خيرية"} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="مؤسسة إتقان" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {isEn ? (
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    ) : (
      <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    )}
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "مؤسسة إتقان للتعليم والتنمية",
        "url": "https://itqaan.sgi.ngo",
        "description": "مؤسسة تعليمية تهتم بتعليم العربية السليمة، وضبط القرآن الكريم وحفظه، والتربية على قيمه ومبادئه.",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+905378980555",
          "email": "info@itkan.info",
          "contactType": "معلومات",
          "availableLanguage": "Arabic"
        },
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "TR",
          "addressLocality": "غازي عنتاب",
          "streetAddress": "كرتاش جانب جامع آمنة"
        }
      }
    </script>

    <!-- Infaque Donation Widget -->
    <script src="https://infaque-cdn.web.app/main.js" async is:inline></script>
  </head>
  <body class="bg-white">
    <slot />
  </body>
</html>

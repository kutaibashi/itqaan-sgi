---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const isEn = lang === 'en';

const defaultTitle = isEn 
  ? "Itkan Foundation for Education and Development" 
  : "مؤسسة إتقان للتعليم والتنمية";

const defaultDesc = isEn
  ? "Itkan is an educational foundation dedicated to teaching proper Arabic, Qur'an recitation, memorization, and nurturing values derived from the Qur'an."
  : "مؤسسة إتقان للتعليم والتنمية - مؤسسة تعليمية تهتم بتعليم العربية السليمة، وضبط القرآن الكريم وحفظه، والتربية على قيمه ومبادئه.";

const {
  title = defaultTitle,
  description = defaultDesc,
} = Astro.props;

const siteUrl = "https://itqaan.sgi.ngo";
const siteName = isEn ? "Itkan Foundation" : "مؤسسة إتقان";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": defaultTitle,
  "url": siteUrl,
  "description": defaultDesc,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+905378980555",
    "email": "info@itkan.info",
    "contactType": isEn ? "Information" : "معلومات",
    "availableLanguage": isEn ? ["English", "Arabic"] : ["Arabic", "English"]
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "TR",
    "addressLocality": isEn ? "Gaziantep" : "غازي عنتاب",
    "streetAddress": isEn ? "Kartaş, next to Aminah Mosque" : "كرتاش جانب جامع آمنة"
  }
};
---

<!DOCTYPE html>
<html lang={lang} dir={isEn ? 'ltr' : 'rtl'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={isEn ? "Itkan, Quran teaching, Quran memorization, Arabic teaching, Syria, Turkey, charity" : "إتقان, تعليم القرآن, حفظ القرآن, تعليم العربية, سوريا, تركيا, مؤسسة خيرية"} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {isEn ? (
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    ) : (
      <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    )}
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)}></script>

    {/*
      Infaque donation widget — self-hosted on purpose. Do not point this back at
      the infaque-cdn.web.app main.js entry point without checking it first.

      2026-08-17: Infaque deleted their entire legacy widget file set. main.js and the three
      files it bootstrapped (donation-widget.js, parent-page-info.js, event-widget.js) all
      now return their SPA shell as text/html, so Chrome refuses the response outright
      (net::ERR_BLOCKED_BY_ORB) and every .donation-widget button on this site was inert.
      Firebase Hosting's catch-all rewrite answers 200 for any missing path, which is why
      this failed silently rather than 404ing.

      The Wayback Machine has main.js as text/javascript on all 31 captures from 2025-02-26
      to 2026-07-11, so this broke on their side. The three files below are the last working
      copies (snapshot 2026-04-30). They already speak the current contract, reading
      data-template-id / data-tenant-id / data-base-url off each .donation-widget element,
      which is exactly how this site's buttons are marked up.

      This is a pinned copy of a vendor's deprecated client, so treat it as a bridge: ask
      Infaque for their current supported embed URL and swap these three lines back.
    */}
    <script is:inline>window.mainReceiverUrl = "https://donate.sgi.ngo/donate-directly/contribution?header=no-header";</script>
    <script src="/infaque/donation-widget.js" async is:inline></script>
    <script src="/infaque/parent-page-info.js" async is:inline></script>
    <script src="/infaque/event-widget.js" async is:inline></script>
  </head>
  <body class="bg-white">
    <slot />
  </body>
</html>
